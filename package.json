{
  "name": "api-test-automation",
  "version": "1.0.0",
  "description": "API Test Automation with BDD + Allure | AI Generated Code (100% AI)",
  "scripts": {
    "test": "npm run test:cucumber && npm run report:generate",
    "test:cucumber": "npx @cucumber/cucumber tests/features/**/*.feature --require tests/support/index.cjs --format json:tests/report/cucumber-report.json --format progress",
    "test:specific": "npx @cucumber/cucumber tests/features/GET_USERS.feature --require tests/support/index.cjs --format progress",
    "report:generate": "node scripts/generate-reports.js",
    "clean": "Remove-Item -Recurse -Force tests\\report\\* -ErrorAction SilentlyContinue",
    "setup": "npm install"
  },
  "keywords": ["api-testing", "bdd", "cucumber"],
  "author": "AI Generated",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@faker-js/faker": "^10.6.0",
    "chai": "^6.2.2"
  }
}
