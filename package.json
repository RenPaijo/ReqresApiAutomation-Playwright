{
  "name": "api-test-automation",
  "version": "1.0.0",
  "description": "API test automation with Cucumber BDD and HTML reports",
  "type": "module",
  "engines": {
    "node": "22 || 24 || >=26"
  },
  "scripts": {
    "test": "npm run test:cucumber && npm run report:generate",
    "typecheck": "tsc --noEmit",
    "test:cucumber": "npx @cucumber/cucumber tests/features/**/*.feature --require 'tests/support/*.ts' --format json:tests/report/cucumber-report.json --format progress",
    "test:specific": "npx @cucumber/cucumber tests/features/get_users.feature --require 'tests/support/*.ts' --format progress",
    "report:generate": "node scripts/generate-reports.js",
    "report:html": "npx serve -s tests/report/html-report -l 4000",
    "clean": "node -e \"const fs=require('node:fs'); for(const path of ['tests/report/cucumber-report.json','tests/report/html-report']) fs.rmSync(path,{recursive:true,force:true})\"",
    "setup": "npm install"
  },
  "keywords": [
    "api-testing",
    "bdd",
    "cucumber"
  ],
  "author": "AI Generated",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@cucumber/messages": "^34.2.1",
    "@faker-js/faker": "^10.6.0",
    "@types/chai": "^5.2.3",
    "@types/node": "^24.10.1",
    "chai": "^5.3.3",
    "serve": "^14.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
